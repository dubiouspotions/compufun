[gd_resource type="Resource" script_class="Day" format=3]

[ext_resource type="Script" path="res://days/day.gd" id="day"]
[ext_resource type="Script" path="res://days/errand.gd" id="errand"]
[ext_resource type="Resource" path="res://customers/retired_accountant.tres" id="retired_accountant"]
[ext_resource type="Resource" path="res://problems/no_sound.tres" id="no_sound"]

[sub_resource type="Resource" id="Errand_1"]
script = ExtResource("errand")
customer = ExtResource("retired_accountant")
problem = ExtResource("no_sound")

[resource]
script = ExtResource("day")
number = 2
warp = 0.15
rain = true
errands = Array[ExtResource("errand")]([SubResource("Errand_1")])
