[ext_resource type="Resource" path="res://problems/no_sound.tres" id="no_sound"]
[ext_resource type="Resource" path="res://customers/activist_guy.tres" id="activist_guy"]
[ext_resource type="Resource" path="res://problems/bad_ram.tres" id="bad_ram"]

[sub_resource type="Resource" id="Errand_1"]
script = ExtResource("errand")
customer = ExtResource("skater_bro")
