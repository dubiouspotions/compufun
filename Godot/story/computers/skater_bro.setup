file C:\Program Files\Raytrace 2\README.TXT
	icon: res://win95/theme/icons/document_text_32.png
	contents:
		RAYTRACE 2.0
		
		Thank you for choosing Raytrace 2! Registered users get the
		printed manual and the next version on floppy disk.
		
		QUICK START
		  Open a scene file (.RAY) to render it. The picture is saved
		  as a .BMP next to the scene file.
		
		RENDER TIMES
		  A complex scene can take many hours, and your computer works
		  hard the whole time. Make sure it has good air flow, and keep
		  the fan and the vents free of dust.
		
		PROBLEMS?
		  If your computer turns itself off during a render, it is
		  probably too hot. Let it cool down, and clean it.
		
	modified: Thursday, November 2, 1995 12:00:00 PM

file C:\My Documents\castle.ray
	icon: res://win95/theme/icons/file_unknown_32.png
	contents:
		// castle.ray - the castle, 3rd try
		// Raytrace 2 scene file
		
		camera   { from <0.6, 1.6, -5>  to <0, 1.2, 2> }
		light    { at <-4, 8, -5> }
		sky      { gradient <0.25, 0.45, 0.9> }
		floor    { checker yellow navy  reflect 0.25 }
		
		// walls and gate
		box      { <-2, 0, 2> <2, 1.5, 2.6>  texture stone }
		box      { <-0.5, 0, 1.9> <0.5, 0.9, 2>  colour <0.25, 0.15, 0.08> }
		repeat 8 { box { <-2 + i * 0.55, 1.5, 2> <-1.72 + i * 0.55, 1.8, 2.6>  texture stone } }
		
		// towers
		cylinder { <-2.2, 0, 2.3>  radius 0.6  height 2.4  texture stone }
		cone     { <-2.2, 2.4, 2.3>  radius 0.75  height 1.2  colour red }
		cylinder { <2.2, 0, 2.3>  radius 0.6  height 2.4  texture stone }
		cone     { <2.2, 2.4, 2.3>  radius 0.75  height 1.2  colour red }
		
		// the chrome ball. Kent says every render needs one
		sphere   { <1.1, 0.6, 0.3>  radius 0.6  colour white  reflect 0.7 }
		
		quality high   // takes ALL night
		
	modified: Wednesday, May 29, 1996 10:58:02 PM

