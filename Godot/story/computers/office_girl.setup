file C:\My Documents\Midsummer party.doc
	icon: res://win95/office/icons/word_document_32.png
	contents:
		{\rtf1\ansi\deff0{\fonttbl{\f0\froman Times New Roman;}}\f0\fs20
		\qc\b\fs40 Midsummer at Harbour Import!\b0\fs20\par
		\qc\par
		\qc\fs24 Thursday, June 20, 1996, at 3 o'clock\fs20\par
		\qc\fs24 In the yard behind the warehouse\fs20\par
		\ql\par
		Dear all,\par
		\par
		Midsummer is almost here, and the containers can wait for one afternoon. Come and celebrate with us before everyone leaves for the islands!\par
		\par
		\b On the table:\b0\par
		Strawberry cake (Sam)\par
		Herring and new potatoes (Margit)\par
		\par
		Flower crowns for everyone. We sing from the song sheets, and \i maybe\i0  Nick brings his guitar.\par
		\par
		Tell me by Monday if you are coming.\par
		\par
		Sam\par
		}
		
	contents_file: res://customers/office_girl/documents/midsummer_party.doc
	summary: {&"title": "Midsummer party", &"author": "Sam Hilton", &"company": "Harbour Import AB"}
	modified: Thursday, May 30, 1996 4:12:40 PM

