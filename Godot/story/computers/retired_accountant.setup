file C:\My Documents\Letter to the tax office.doc
	icon: res://win95/office/icons/word_document_32.png
	contents:
		{\rtf1\ansi\deff0{\fonttbl{\f0\froman Times New Roman;}}\f0\fs20
		Bob\par
		\par
		To the Tax Office\par
		\par
		\par
		\b Re: My tax return for 1995\b0\par
		\par
		Dear Sir or Madam,\par
		\par
		Enclosed is my tax return for 1995. My nephew Kev put more memory in my computer, so I could do the figures myself this year.\par
		\par
		I have deducted nothing for the computer. I use it for the tax returns, and for solitaire.\par
		\par
		Yours faithfully,\par
		\par
		Bob\par
		}
		
	contents_file: res://customers/retired_accountant/documents/tax_office.doc
	summary: {&"title": "My tax return for 1995", &"author": "Bob"}
	modified: Friday, May 24, 1996 10:20:15 AM

file C:\My Documents\Tax return 1995.xls
	icon: res://win95/office/icons/excel_worksheet_32.png
	contents:
		# Bob's tax return for 1995. Placeholder for the writers.
		A width: 30
		B width: 12
		A1 bold: TAX RETURN 1995
		A3 bold underline: Income
		B3 bold right: kr
		A4: Pension
		B4 comma 0: 118400
		A5: Interest, savings account
		B5 comma 0: 2315
		A6 bold: Total income
		B6 bold comma 0: 120715
		A8 bold underline: Deductions
		A9: Memory for the computer (Kev)
		B9 comma 0: 0
		A10: Stamps for the tax office
		B10 comma 0: 28
		A11 bold: Total deductions
		B11 bold comma 0: 28
		A13 italic: Check every figure twice. Then once more.
		
	contents_file: res://customers/retired_accountant/documents/tax_return_1995.xls
