[sub_resource type="Resource" id="readme"]
script = ExtResource("4_file")
name = "README.TXT"
icon = ExtResource("6_text_icon")
contents = "CompuFun AntiVirus 1.0
======================

TO INSTALL
Put this disk in drive A:. Open My Computer, then 3 1/2 Floppy (A:),
and double-click SETUP.EXE. Setup copies the scanner to
C:\\Program Files\\CompuFun AntiVirus.

TO SCAN
Double-click CompuFun AntiVirus on the desktop, or click Start,
Programs, CompuFun AntiVirus. Click Scan Now. If the scanner finds
a virus, click Clean.

Scan every computer that comes through the shop.
A clean computer is a happy customer!

CompuFun Software Division, 1996
"
modified = "Monday, March 4, 1996 10:00:00 AM"

