[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/theme.tres" id="theme"]
[ext_resource type="Script" path="res://ui/phone_call.gd" id="script"]

[node name="PhoneCall" type="PanelContainer"]
custom_minimum_size = Vector2(560, 0)
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -280.0
offset_top = -120.0
offset_right = 280.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Call a customer"

[node name="Choices" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="Talk" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="YouSay" type="Label" parent="Margin/Column/Talk"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
autowrap_mode = 3

[node name="TheySay" type="Label" parent="Margin/Column/Talk"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Note" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="Action" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
text = "Put down"
