handle_input_locally = false

[node name="Center" type="CenterContainer" parent="Dialog/Buffer"]
unique_name_in_owner = true

[node name="MessageBox" parent="Dialog/Buffer/Center" instance=ExtResource("2_box")]
unique_name_in_owner = true
layout_mode = 2

[node name="Panel" type="PanelContainer" parent="."]
