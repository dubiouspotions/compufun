[gd_scene format=3]

[ext_resource type="Script" path="res://ui/end_of_day.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://win95/message_box.tscn" id="2_box"]
[ext_resource type="Theme" path="res://ui/theme.tres" id="3_theme"]

[node name="EndOfDay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_script")

[node name="Dialog" type="SubViewportContainer" parent="."]
unique_name_in_owner = true
texture_filter = 1
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
stretch = true
stretch_shrink = 2

[node name="Buffer" type="SubViewport" parent="Dialog"]
unique_name_in_owner = true
