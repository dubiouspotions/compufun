[gd_scene format=3]

[ext_resource type="Script" path="res://ui/customer_calling.gd" id="script"]

[node name="CustomerCalling" type="PanelContainer"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_top = 96.0
grow_horizontal = 2
mouse_filter = 2
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 10

[node name="Line" type="Label" parent="Margin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Customer: Hello?"
