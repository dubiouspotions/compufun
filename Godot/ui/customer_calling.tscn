[gd_scene format=3]

[ext_resource type="Script" path="res://voices/voice_player.gd" id="voice_player"]
[ext_resource type="Script" path="res://ui/customer_calling.gd" id="script"]
[ext_resource type="Script" path="res://ui/typed_label.gd" id="typed_label"]
[ext_resource type="FontFile" path="res://win95/theme/fonts/w95fa_pixel_regular.ttf" id="pixel"]
[ext_resource type="FontFile" path="res://win95/theme/fonts/w95fa_pixel_bold.ttf" id="pixel_bold"]

[sub_resource type="StyleBoxFlat" id="box"]
content_margin_left = 28.0
content_margin_top = 16.0
content_margin_right = 28.0
content_margin_bottom = 16.0
bg_color = Color(0.05, 0.05, 0.09, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.3, 0.3, 0.34, 1)

[node name="CustomerCalling" type="PanelContainer"]
mouse_filter = 2
theme_override_styles/panel = SubResource("box")
script = ExtResource("script")

[node name="Text" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.45, 1)
theme_override_fonts/font = ExtResource("pixel_bold")
theme_override_font_sizes/font_size = 28
text = "Customer"

[node name="Line" type="Label" parent="Text"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("typed_label")
chars_per_second = 0.0
visible_characters_behavior = 1
theme_override_colors/font_color = Color(0.96, 0.95, 0.92, 1)
theme_override_fonts/font = ExtResource("pixel")
theme_override_font_sizes/font_size = 28
text = "Hello?"

[node name="Voice" type="AudioStreamPlayer" parent="."]
unique_name_in_owner = true
script = ExtResource("voice_player")

[node name="Timer" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true
