[gd_scene format=3]

[ext_resource type="Script" path="res://corruption/no_clippy.gd" id="1_script"]

[node name="NoClippy" type="Node"]
script = ExtResource("1_script")
title = "Clippy is gone from every computer"
description = "The Office Assistant's window in Word and Excel shows no paper clip, though its balloons, tips and menu still work; every WordPad shows the assistant's frame empty."
hint = "Open Word or Excel on a computer."
