[node name="Calc666" type="Node"]
script = ExtResource("1_script")
title = "Every result is 666 in the skater bro's Cambion computer"
description = "In the skater bro's computer, while it runs Cambion (the story sets skater_bro_runs_cambion), every result of the Calculator is 666. Other Cambion computers add up."
hint = "Open the Calculator in the skater bro's computer."
target = ExtResource("2_target")
