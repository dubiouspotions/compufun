[ext_resource type="Script" path="res://corruption/pipedream.gd" id="1_sign"]

[node name="Pipedream" type="Node"]
script = ExtResource("1_sign")
title = "The Pipedream grows in the corner"
timing = 1
description = "Win95 Pipes grow out of the corner right of the work desk, but only while that corner is off screen. 1: as many as the day's warp allows (all at warp 1). 2: all of them."
hint = "Look away from the Right View for a while, then back at the corner right of the work desk."
stages = 2
