[ext_resource type="Script" path="res://corruption/posters_bounce.gd" id="1_script"]

[node name="PostersBounce" type="Node3D"]
script = ExtResource("1_script")
title = "The logos and a poster bounce off the walls like the Solitaire win"
timing = 2
description = "When the player closes the shop on day 5, the Open sign turns over, and 0.6 s later it, then the logo on the left wall, the poster on the right wall and last the logo over the door, 2.5 s apart, each shake in their places, turn to face the counter and bounce across the shop between the counter and the door, leaving a trail of copies lit like the room, each drawn over the ones before it. The night waits for them. As the last one lands and the night fades out, the FUNtastic sticker, the TRASH poster and the taped note on the counter front follow, 0.3 s apart, bouncing along the front of the counter. Then they stay on the floor (2); the next day they are back in their places."
hint = "Close the shop on day 5. Then stage 2."
stages = 2

[node name="Trail" type="Node3D" parent="."]
unique_name_in_owner = true
