[node name="Win95Boxes" type="Node"]
script = ExtResource("1_sign")
title = "The shelf boxes become Windows 95 boxes"
timing = 2
description = "Every box on the wall shelving's boards (software, modems, CD-ROM drives, speakers, keyboards, mice and floppies) is a Windows 95 retail box: the flag on a blue sky and WIN95. The cards and cables on the pegboard stay."
hint = "The wall shelving, in the Left View."
boxes = SubResource("ShaderMaterial_boxes")
