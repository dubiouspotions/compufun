[gd_scene format=3]

[ext_resource type="Script" path="res://corruption/pointer_escape.gd" id="1_script"]

[node name="PointerEscape" type="Node"]
script = ExtResource("1_script")
title = "The Windows arrow follows the mouse off a Cambion screen"
timing = 1
description = "Now and then, when the mouse leaves the bench screen of a computer that runs Cambion, the Win95 arrow stays the mouse cursor over the shop for a few seconds before the game's cursor returns. Days 3 to 5."
hint = "Connect a Cambion computer, open the Screen View and move the mouse off the screen, a few times."
