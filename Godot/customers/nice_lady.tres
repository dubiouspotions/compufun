[sub_resource type="Resource" id="Resource_6xuns"]
script = ExtResource("39_ccnue")
text = "Only a little. I had the computer under my coat."
pose = &"happy"

[sub_resource type="Resource" id="Resource_8sjg8"]
script = ExtResource("38_cawpx")
lines = Array[ExtResource("39_ccnue")]([SubResource("Resource_6xuns")])

[sub_resource type="Resource" id="Resource_qtd8m"]
script = ExtResource("37_8derm")
text = "Did you get wet?"
replies = Array[ExtResource("38_cawpx")]([SubResource("Resource_8sjg8")])

[sub_resource type="Resource" id="Resource_02l2s"]
script = ExtResource("39_ccnue")
text = "Only the children's hamster, Nibbles. He got out on Sunday, the little rascal."
pose = &"happy"

[sub_resource type="Resource" id="Resource_3bpa1"]
script = ExtResource("38_cawpx")
lines = Array[ExtResource("39_ccnue")]([SubResource("Resource_02l2s")])

[sub_resource type="Resource" id="Resource_plujm"]
script = ExtResource("37_8derm")
text = "Any pets at home?"
replies = Array[ExtResource("38_cawpx")]([SubResource("Resource_3bpa1")])

[sub_resource type="Resource" id="Resource_4bpgp"]
script = ExtResource("39_ccnue")
text = "Thank you, dear. No rush."
pose = &"happy"

[sub_resource type="Resource" id="Resource_u0up8"]
script = ExtResource("38_cawpx")
lines = Array[ExtResource("39_ccnue")]([SubResource("Resource_4bpgp")])

[sub_resource type="Resource" id="Resource_u0b5t"]
script = ExtResource("37_8derm")
text = "OK, leave it with me."
replies = Array[ExtResource("38_cawpx")]([SubResource("Resource_u0up8")])
ends = true

[sub_resource type="Resource" id="Resource_r7185"]
script = ExtResource("39_ccnue")
text = "It starts, and then it just switches itself off again."
pose = &"problem"

[sub_resource type="Resource" id="Resource_h2wax"]
script = ExtResource("39_ccnue")
text = "And it smells a bit funny. Like a pet shop."

[sub_resource type="Resource" id="Resource_g00uy"]
script = ExtResource("38_cawpx")
lines = Array[ExtResource("39_ccnue")]([SubResource("Resource_r7185"), SubResource("Resource_h2wax")])
choices = Array[ExtResource("37_8derm")]([SubResource("Resource_plujm"), SubResource("Resource_u0b5t")])

[sub_resource type="Resource" id="Resource_7u20g"]
script = ExtResource("37_8derm")
text = "So, what's your problem?"
replies = Array[ExtResource("38_cawpx")]([SubResource("Resource_g00uy")])

[sub_resource type="Resource" id="Resource_3dmmx"]
script = ExtResource("39_ccnue")
text = "Oh, hello dear. Isn't this rain something?"
pose = &"happy"

[sub_resource type="Resource" id="Resource_hhxjg"]
script = ExtResource("36_vkhl3")
id = &"arrive"
lines = Array[ExtResource("39_ccnue")]([SubResource("Resource_3dmmx")])
choices = Array[ExtResource("37_8derm")]([SubResource("Resource_qtd8m"), SubResource("Resource_7u20g")])

[sub_resource type="Resource" id="Resource_rbnqm"]
script = ExtResource("39_ccnue")
text = "It works! Oh, and you didn't see a hamster anywhere, did you?"
pose = &"happy"

[sub_resource type="Resource" id="Resource_8q3hg"]
script = ExtResource("36_vkhl3")
id = &"pickup"
trigger = 1
lines = Array[ExtResource("39_ccnue")]([SubResource("Resource_rbnqm")])

