[sub_resource type="Resource" id="Computer_accountant"]
script = ExtResource("1_2x16c")
win95_setup = SubResource("Setup_accountant")
hardware = SubResource("Hardware_486")
case_material = ExtResource("case_yellowed")
case_front = ExtResource("front_drive_door")

[sub_resource type="Resource" id="Resource_gs1ce"]
script = ExtResource("dl")
text = "No! Well. I might have clicked the little speaker."
pose = &"thinking"

[sub_resource type="Resource" id="Resource_5e6l0"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_gs1ce")])

[sub_resource type="Resource" id="Resource_5blj2"]
script = ExtResource("38_21cv8")
text = "Did you touch the volume?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_5e6l0")])

[sub_resource type="Resource" id="Resource_633m2"]
script = ExtResource("dl")
text = "Yes, he sat in the corner and helped. Now there's only an empty note."
pose = &"irritated01"

[sub_resource type="Resource" id="Resource_0w4qd"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_633m2")])

[sub_resource type="Resource" id="Resource_21cv8"]
script = ExtResource("38_21cv8")
text = "The paperclip?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_0w4qd")])

[sub_resource type="Resource" id="Resource_748tm"]
script = ExtResource("dl")
text = "Thank you. And if you can find the paperclip..."

[sub_resource type="Resource" id="Resource_f3h33"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_748tm")])

[sub_resource type="Resource" id="Resource_87aal"]
script = ExtResource("38_21cv8")
text = "OK, leave it with me."
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_f3h33")])
ends = true

[sub_resource type="Resource" id="Resource_b4so3"]
script = ExtResource("dl")
text = "The sound is gone again. And now the little paperclip in my letters is gone too."
pose = &"problem"

[sub_resource type="Resource" id="Resource_at1hd"]
script = ExtResource("dl")
text = "He always helped me with the tax letters."

[sub_resource type="Resource" id="Resource_v6jxh"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_b4so3"), SubResource("Resource_at1hd")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_5blj2"), SubResource("Resource_21cv8"), SubResource("Resource_87aal")])

[sub_resource type="Resource" id="Resource_b2db5"]
script = ExtResource("38_21cv8")
text = "So, what's your problem?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_v6jxh")])

[sub_resource type="Resource" id="Resource_jjfxu"]
script = ExtResource("dl")
text = "It's me. Again. I'm so sorry."
pose = &"irritated01"

[sub_resource type="Resource" id="Resource_5kbo0"]
script = ExtResource("condition")
from_day = 3
to_day = 3

[sub_resource type="Resource" id="Resource_keclr"]
script = ExtResource("cv")
id = &"clippy_gone"
when = SubResource("Resource_5kbo0")
set_flags = Dictionary[StringName, int]({
&"sign_no_clippy": 1
})
lines = Array[ExtResource("dl")]([SubResource("Resource_jjfxu")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_b2db5")])

[sub_resource type="Resource" id="Resource_khefh"]
script = ExtResource("dl")
text = "Oh. Well. He had a good run, the little fellow."

[sub_resource type="Resource" id="Resource_mhykb"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_khefh")])

[sub_resource type="Resource" id="Resource_rx7fq"]
script = ExtResource("38_21cv8")
text = "I couldn't bring him back."
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_mhykb")])
ends = true

[sub_resource type="Resource" id="Resource_k0j6j"]
script = ExtResource("dl")
text = "It plays its little tune again. And the paperclip?"
pose = &"happy"

[sub_resource type="Resource" id="Resource_5p518"]
script = ExtResource("condition")
from_day = 3
to_day = 3

[sub_resource type="Resource" id="Resource_0savs"]
script = ExtResource("cv")
id = &"clippy_pickup"
trigger = 1
when = SubResource("Resource_5p518")
lines = Array[ExtResource("dl")]([SubResource("Resource_k0j6j")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_rx7fq")])

[sub_resource type="Resource" id="Resource_ep33l"]
script = ExtResource("dl")
text = "Believe me, I'd rather not be."
pose = &"irritated02"

[sub_resource type="Resource" id="Resource_bmhnm"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_ep33l")])

[sub_resource type="Resource" id="Resource_b6qpg"]
script = ExtResource("38_21cv8")
text = "Back so soon?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_bmhnm")])

[sub_resource type="Resource" id="Resource_863hf"]
script = ExtResource("dl")
text = "Well... maybe I clicked the little speaker. Once. Or twice."
pose = &"thinking"

[sub_resource type="Resource" id="Resource_ks1hr"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_863hf")])

[sub_resource type="Resource" id="Resource_cqlim"]
script = ExtResource("38_21cv8")
text = "Really nothing? Not even the volume?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_ks1hr")])

[sub_resource type="Resource" id="Resource_ne3wx"]
script = ExtResource("dl")
text = "Please hurry. The tax office won't wait."
pose = &"irritated01"

[sub_resource type="Resource" id="Resource_xsvqa"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_ne3wx")])

[sub_resource type="Resource" id="Resource_51wgf"]
script = ExtResource("38_21cv8")
text = "OK, leave it with me."
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_xsvqa")])
ends = true

[sub_resource type="Resource" id="Line_again_1"]
script = ExtResource("dl")
text = "It's silent again! Since last night. I didn't touch a thing, I promise."
pose = &"irritated01"

[sub_resource type="Resource" id="Resource_wpb5g"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Line_again_1")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_cqlim"), SubResource("Resource_51wgf")])

[sub_resource type="Resource" id="Resource_vvebn"]
script = ExtResource("38_21cv8")
text = "So, what's your problem?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_wpb5g")])

[sub_resource type="Resource" id="Resource_bpmi6"]
script = ExtResource("dl")
text = "Hello again."
pose = &"irritated01"

[sub_resource type="Resource" id="When_day_2"]
script = ExtResource("condition")
from_day = 2
to_day = 2

[sub_resource type="Resource" id="Conversation_again"]
script = ExtResource("cv")
id = &"silent_again"
when = SubResource("When_day_2")
lines = Array[ExtResource("dl")]([SubResource("Resource_bpmi6")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_b6qpg"), SubResource("Resource_vvebn")])

[sub_resource type="Resource" id="Resource_tytfh"]
script = ExtResource("dl")
text = "Is it? I hadn't noticed. I've been inside with the tax returns all week."

[sub_resource type="Resource" id="Resource_cmddj"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Resource_tytfh")])

[sub_resource type="Resource" id="Resource_h1eqg"]
script = ExtResource("38_21cv8")
text = "Lovely weather today."
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_cmddj")])

[sub_resource type="Resource" id="Line_arrive_2"]
script = ExtResource("dl")
text = "My nephew says it is something in the settings, but I don't dare touch them."

[sub_resource type="Resource" id="Resource_ekp0o"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Line_arrive_2")])

[sub_resource type="Resource" id="Resource_uapy0"]
script = ExtResource("38_21cv8")
text = "Has anyone looked at it?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_ekp0o")])

[sub_resource type="Resource" id="Line_arrive_3"]
script = ExtResource("dl")
text = "I need it for the tax returns, so please be quick."

[sub_resource type="Resource" id="Resource_8beia"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Line_arrive_3")])

[sub_resource type="Resource" id="Resource_qhjbq"]
script = ExtResource("38_21cv8")
text = "OK, leave it with me."
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_8beia")])
ends = true

[sub_resource type="Resource" id="Line_arrive_1"]
script = ExtResource("dl")
text = "My computer has gone quiet. Not a sound, not even the little tune when it starts."
pose = &"problem"

[sub_resource type="Resource" id="Resource_1xe35"]
script = ExtResource("39_748tm")
lines = Array[ExtResource("dl")]([SubResource("Line_arrive_1")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_uapy0"), SubResource("Resource_qhjbq")])

[sub_resource type="Resource" id="Resource_bw53v"]
script = ExtResource("38_21cv8")
text = "So, what's your problem?"
replies = Array[ExtResource("39_748tm")]([SubResource("Resource_1xe35")])

[sub_resource type="Resource" id="Resource_cxtt3"]
script = ExtResource("dl")
text = "Good day."

[sub_resource type="Resource" id="Conversation_arrive"]
script = ExtResource("cv")
id = &"arrive"
lines = Array[ExtResource("dl")]([SubResource("Resource_cxtt3")])
choices = Array[ExtResource("38_21cv8")]([SubResource("Resource_h1eqg"), SubResource("Resource_bw53v")])

[sub_resource type="Resource" id="Line_pickup_1"]
script = ExtResource("dl")
text = "It plays its little tune again? Wonderful."
pose = &"happy"

[sub_resource type="Resource" id="Conversation_pickup"]
script = ExtResource("cv")
id = &"pickup"
trigger = 1
lines = Array[ExtResource("dl")]([SubResource("Line_pickup_1")])

[resource]
script = ExtResource("3_10hmr")
display_name = "Retired accountant"
person = ExtResource("person")
conversations = Array[ExtResource("cv")]([SubResource("Resource_keclr"), SubResource("Resource_0savs"), SubResource("Conversation_again"), SubResource("Conversation_arrive"), SubResource("Conversation_pickup")])
computer = SubResource("Computer_accountant")
trousers_color = Color(0.36, 0.3, 0.22, 1)
hat = ExtResource("hat_fedora")
