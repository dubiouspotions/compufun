[sub_resource type="Resource" id="Resource_f0q70"]
script = ExtResource("41_fhk55")
text = "Always. And someone thinks pranks are a business strategy."
pose = &"irritated01"

[sub_resource type="Resource" id="Resource_ocxll"]
script = ExtResource("40_v4b2o")
lines = Array[ExtResource("41_fhk55")]([SubResource("Resource_f0q70")])

[sub_resource type="Resource" id="Resource_1vc6y"]
script = ExtResource("39_8ylkx")
text = "Busy at the office?"
replies = Array[ExtResource("40_v4b2o")]([SubResource("Resource_ocxll")])

[sub_resource type="Resource" id="Resource_av20o"]
script = ExtResource("41_fhk55")
text = "I left it on over lunch. When I came back, it looked like this."
pose = &"thinking"

[sub_resource type="Resource" id="Resource_y7gyy"]
script = ExtResource("40_v4b2o")
lines = Array[ExtResource("41_fhk55")]([SubResource("Resource_av20o")])

[sub_resource type="Resource" id="Resource_801m2"]
script = ExtResource("39_8ylkx")
text = "Did someone use it?"
replies = Array[ExtResource("40_v4b2o")]([SubResource("Resource_y7gyy")])

[sub_resource type="Resource" id="Resource_0ld84"]
script = ExtResource("41_fhk55")
text = "Thank you. Please make it normal again."

[sub_resource type="Resource" id="Resource_311ln"]
script = ExtResource("40_v4b2o")
lines = Array[ExtResource("41_fhk55")]([SubResource("Resource_0ld84")])

[sub_resource type="Resource" id="Resource_125jc"]
script = ExtResource("39_8ylkx")
text = "OK, leave it with me."
replies = Array[ExtResource("40_v4b2o")]([SubResource("Resource_311ln")])
ends = true

[sub_resource type="Resource" id="Resource_i772n"]
