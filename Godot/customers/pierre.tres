[sub_resource type="Resource" id="Resource_ovstq"]
script = ExtResource("9_5i8g7")
from = "Kent <kent@modemlandia.se>"
to = "pierre@modemlandia.se"
subject = "Re: the castle"
body = "Did the render finish overnight? Mine took 14 hours.

Tip: take the side panel off. It runs cooler.

/Kent"

[sub_resource type="Resource" id="Resource_t3ecn"]
script = ExtResource("9_5i8g7")
from = "Modemlandia <support@modemlandia.se>"
to = "pierre@modemlandia.se"
subject = "Welcome to Modemlandia!"
body = "Welcome! Your account is ready. Dial 08-555 123 45 to connect.

You can call our support line on weekdays, 9 to 17."
read = true

[sub_resource type="Resource" id="Resource_ri5pa"]
script = ExtResource("9_5i8g7")
folder = 1
from = "pierre@modemlandia.se"
to = "Kent <kent@modemlandia.se>"
subject = "the castle"
body = "Starting the big render tonight. If the house burns down, you know why."
read = true

[sub_resource type="Resource" id="Resource_ch6ki"]
script = ExtResource("9_5i8g7")
folder = 2
from = "Modemlandia <offers@modemlandia.se>"
to = "pierre@modemlandia.se"
subject = "Double your speed: 28.8k is here"
body = "Upgrade to our new 28.8k lines for only 49 kr more a month!"
read = true

