[ext_resource type="Resource" path="res://problems/dust_overheat.tres" id="2_7x3xp"]
[ext_resource type="Script" path="res://customers/customer.gd" id="3_tc2lv"]
[ext_resource type="Script" path="res://customers/dialogue_line.gd" id="dl"]
[ext_resource type="Script" path="res://customers/conversation.gd" id="cv"]

[sub_resource type="Resource" id="DialogueLine_1"]
script = ExtResource("dl")
text = "Hi. My computer starts Windows, and then it just turns off."

[sub_resource type="Resource" id="DialogueLine_2"]
script = ExtResource("dl")
text = "It gets warm, I think."

[sub_resource type="Resource" id="Conversation_arrive"]
script = ExtResource("cv")
id = &"arrive"
lines = Array[ExtResource("dl")]([SubResource("DialogueLine_1"), SubResource("DialogueLine_2")])

[resource]
script = ExtResource("3_tc2lv")
display_name = "Pierre"
person = ExtResource("1_teewq")
