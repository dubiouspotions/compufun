[sub_resource type="Resource" id="Resource_letter"]
script = ExtResource("2_egn44")
name = "from Kev.txt"
icon = ExtResource("4_qsrht")
contents = "Uncle Bob,

Put the 8 megs from my old box in yours. Twice the memory, so it should fly now.

- Kev
"
modified = "Saturday, April 27, 1996 3:12:05 PM"

