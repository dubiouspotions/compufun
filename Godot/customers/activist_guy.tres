[sub_resource type="Resource" id="Page_park"]
script = ExtResource("2_egn44")
name = "PARK.HTM"
icon = ExtResource("icon_netscape")
contents = "<HTML>
<HEAD><TITLE>Save Elm Park!</TITLE></HEAD>
<BODY BGCOLOR=\"#FFFFFF\" TEXT=\"#000000\" LINK=\"#006600\">
<CENTER>
<IMG SRC=\"http://www.geocities.com/RainForest/1996/tree.gif\" ALT=\"Elm Park\">
<H1><FONT COLOR=\"green\">Save Elm Park!</FONT></H1>
<I>A parking lot is not a park.</I>
</CENTER>
<HR>
<P>The city council wants to pave over <B>Elm Park</B> for a 300-car parking lot. The vote is on
<B>June 12, 1996</B>. We have until then.

<H2>What you can do</H2>
<OL>
<LI>Sign the petition at the library or at CompuFun's counter.
<LI>Write to your council member.
<LI>Come to the council meeting on June 12.
</OL>

<P>Signatures so far: <FONT SIZE=+2><B>412</B></FONT>

<HR>
<ADDRESS>Friends of Elm Park. Webmaster: <A HREF=\"mailto:bob@aol.com\">bob@aol.com</A><BR>
<A HREF=\"http://www.geocities.com/RainForest/1996/\">Back to the Friends of Elm Park home page</A></ADDRESS>
</BODY>
</HTML>
"
modified = "Wednesday, May 29, 1996 11:42:10 PM"

