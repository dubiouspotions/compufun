[sub_resource type="Resource" id="Cache_home"]
script = ExtResource("2_egn44")
name = "M0K7Q2RA.HTM"
icon = ExtResource("icon_netscape")
contents = "<HTML>
<HEAD><TITLE>Welcome to Netscape</TITLE></HEAD>
<BODY BGCOLOR=\"#FFFFFF\" TEXT=\"#000000\" LINK=\"#0000FF\" VLINK=\"#FF0000\">
<CENTER>
<IMG SRC=\"/images/n_logo.gif\" WIDTH=48 HEIGHT=48 ALT=\"Netscape\">
<H1>WELCOME TO NETSCAPE</H1>
<FONT SIZE=2>
<A HREF=\"/comprod/index.html\">COMPANY &amp; PRODUCTS</A> |
<A HREF=\"/comprod/mirror/index.html\">SOFTWARE</A> |
<A HREF=\"/home/internet-search.html\">NET SEARCH</A> |
<A HREF=\"/escapes/index.html\">DESTINATIONS</A> |
<A HREF=\"http://merchant.netscape.com/netstore/index.html\">GENERAL STORE</A>
</FONT>
</CENTER>
<HR>

<H3>NAVIGATOR 3.0 BETA: HEAR IT, SEE IT, STEP INSIDE</H3>
The newest beta of Netscape Navigator plays sound, video and 3D worlds right in the page, with
no extra programs to set up. <A HREF=\"/comprod/mirror/client_download.html\">Try the beta today</A>.

<H3>BUILD YOUR OWN HOME PAGE WITH NAVIGATOR GOLD</H3>
Navigator Gold edits web pages as easily as it browses them. Type, drag in a picture, and publish
your page to the Web in one step. <A HREF=\"/comprod/products/navigator/gold/index.html\">Find out how</A>.

<H3>SUITESPOT: SERVERS FOR YOUR INTRANET</H3>
Mail, news, catalogs and more, on one family of servers for the web inside your company.
<A HREF=\"/comprod/server_central/index.html\">Take the tour</A>.

<H3>MORE NEWS</H3>
<UL>
<LI><A HREF=\"/newsref/pr/index.html\">JavaScript now works across Navigator on every platform</A>
<LI><A HREF=\"/comprod/products/navigator/personal/index.html\">Navigator Personal Edition: everything you need to get on the Internet</A>
<LI><A HREF=\"/comprod/power_pack/index.html\">Power Pack 2.0 adds plug-ins, a virus scanner and more</A>
</UL>
<HR>

<B>DOWNLOAD OR PURCHASE NETSCAPE SOFTWARE</B><BR>
<A HREF=\"/comprod/mirror/client_download.html\">Navigator 2.0</A> -
<A HREF=\"/comprod/mirror/client_download.html\">Navigator Gold 2.0</A> -
<A HREF=\"/comprod/mirror/client_download.html\">Navigator 3.0 beta</A> -
<A HREF=\"http://merchant.netscape.com/netstore/index.html\">Buy at the General Store</A>

<P><B>GENERAL STORE SPECIAL:</B> Netscape coffee mugs and T-shirts, shipped to your door.
<HR>
<CENTER><FONT SIZE=2>Copyright &copy; 1996 Netscape Communications Corporation</FONT></CENTER>
</BODY>
</HTML>
"
