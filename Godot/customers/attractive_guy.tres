[sub_resource type="Resource" id="Resource_tnpmq"]
script = ExtResource("6_r4mep")
name = "WIN.INI"
icon = ExtResource("16_ljkrv")
contents = "[windows]
load=
run=
NullPort=None
device=

[Desktop]
TileWallpaper=0
WallpaperStyle=0

[intl]
iCountry=46
sCountry=Sweden
sLanguage=sve

[extensions]
txt=notepad.exe ^.txt
ini=notepad.exe ^.ini
bmp=pbrush.exe ^.bmp
ray=C:\\PROGRA~1\\RAYTRA~1\\RAYTRACE.EXE ^.ray

[mci extensions]
mid=Sequencer
wav=WaveAudio
"
modified = "Tuesday, April 2, 1996 8:31:12 PM"

[sub_resource type="Resource" id="Resource_65bi3"]
script = ExtResource("6_r4mep")
name = "SYSTEM.INI"
icon = ExtResource("16_ljkrv")
contents = "[boot]
shell=Explorer.exe
system.drv=system.drv
drivers=mmsystem.dll power.drv
display.drv=pnpdrvr.drv
mouse.drv=mouse.drv
keyboard.drv=keyboard.drv

[boot.description]
keyboard.typ=Standard 101/102-Key or Microsoft Natural Keyboard
mouse.drv=Standard mouse
display.drv=Standard Display Adapter (VGA)

[386Enh]
ebios=*ebios
woafont=dosapp.fon
device=*vmouse
device=*vshare
keyboard=*vkd
display=*vdd,*vflatd

[drivers]
wave=mmsndsys.drv
midimapper=midimap.drv
"
modified = "Sunday, September 3, 1995 2:22:08 PM"

