[sub_resource type="Resource" id="Resource_pdq6s"]
script = ExtResource("7_pq1pi")
from = "Lisa <lisa@modemlandia.se>"
to = "javve@modemlandia.se"
subject = "Did you listen??"
body = "Did you listen to the mix I sent? You haven't said a word. Is it that bad?"

[sub_resource type="Resource" id="Resource_jonve"]
script = ExtResource("7_pq1pi")
from = "Lisa <lisa@modemlandia.se>"
