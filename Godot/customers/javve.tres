[sub_resource type="Resource" id="Resource_1wfhb"]
script = ExtResource("2_egn44")
name = "lyrics.txt"
icon = ExtResource("4_qsrht")
contents = "DIAL TONE HEART (demo final)

I call you up at two a.m.
The line goes beep, and beep again.
You never pick up, you never do.
I leave the modem on for you.

  Dial tone heart, dial tone heart,
  static where we fell apart.
  I hear you in the hum, I hear you in the dark,
  nothing on the line but my dial tone heart.

Verse 2: ??? (Lisa has ideas)
Bridge: la la la (FIX THIS)
"
modified = "Tuesday, May 28, 1996 1:33:09 AM"

[sub_resource type="Resource" id="Resource_r3t4y"]
script = ExtResource("2_egn44")
name = "System"
icon = ExtResource("5_lymrw")
is_folder = true

[sub_resource type="Resource" id="Resource_4fbej"]
script = ExtResource("2_egn44")
name = "WIN.INI"
icon = ExtResource("6_m26x5")
contents = "[windows]
load=
run=
NullPort=None
device=

[Desktop]
TileWallpaper=0
WallpaperStyle=0

[intl]
iCountry=46
sCountry=Sweden
sLanguage=sve

[extensions]
txt=notepad.exe ^.txt
ini=notepad.exe ^.ini
bmp=pbrush.exe ^.bmp

[mci extensions]
mid=Sequencer
wav=WaveAudio
"
modified = "Saturday, October 21, 1995 4:04:37 PM"

[sub_resource type="Resource" id="Resource_irgbr"]
script = ExtResource("2_egn44")
name = "SYSTEM.INI"
icon = ExtResource("6_m26x5")
contents = "[boot]
shell=Explorer.exe
system.drv=system.drv
drivers=mmsystem.dll power.drv
display.drv=pnpdrvr.drv
mouse.drv=mouse.drv
keyboard.drv=keyboard.drv

[boot.description]
keyboard.typ=Standard 101/102-Key or Microsoft Natural Keyboard
mouse.drv=Standard mouse
display.drv=Standard Display Adapter (VGA)

[386Enh]
ebios=*ebios
woafont=dosapp.fon
device=*vmouse
device=*vshare
keyboard=*vkd
display=*vdd,*vflatd

[drivers]
wave=sb16snd.drv
midimapper=midimap.drv
"
modified = "Saturday, October 21, 1995 3:47:19 PM"

