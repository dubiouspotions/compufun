lines = Array[ExtResource("dl")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4"), SubResource("line_5"), SubResource("line_6"), SubResource("line_7"), SubResource("line_8"), SubResource("line_9"), SubResource("line_10"), SubResource("line_11"), SubResource("line_12"), SubResource("line_13"), SubResource("line_14"), SubResource("line_15"), SubResource("line_16"), SubResource("line_17"), SubResource("line_18"), SubResource("line_19"), SubResource("line_20"), SubResource("line_21"), SubResource("line_22"), SubResource("line_23"), SubResource("line_24"), SubResource("line_25"), SubResource("line_26"), SubResource("line_27"), SubResource("line_28"), SubResource("line_29"), SubResource("line_30"), SubResource("line_31"), SubResource("line_32"), SubResource("line_33"), SubResource("line_34"), SubResource("line_35"), SubResource("line_36"), SubResource("line_37"), SubResource("line_38"), SubResource("line_39"), SubResource("line_40")])
