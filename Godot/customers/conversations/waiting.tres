[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://customers/conversation.gd" id="cv"]
[ext_resource type="Script" path="res://customers/dialogue_line.gd" id="dl"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("dl")
text = "Hello..."
mood = &"neutral"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("dl")
text = "Hi?"
mood = &"neutral"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("dl")
text = "Hello there?"
mood = &"neutral"

[sub_resource type="Resource" id="line_4"]
script = ExtResource("dl")
text = "Anyone here?"
mood = &"neutral"

[sub_resource type="Resource" id="line_5"]
script = ExtResource("dl")
text = "Hi, um... I have a computer?"
mood = &"neutral"

[sub_resource type="Resource" id="line_6"]
script = ExtResource("dl")
text = "Is the shop open?"
mood = &"neutral"

[sub_resource type="Resource" id="line_7"]
script = ExtResource("dl")
text = "The sign said open..."
mood = &"neutral"

[sub_resource type="Resource" id="line_8"]
script = ExtResource("dl")
text = "Knock knock?"
mood = &"neutral"

[sub_resource type="Resource" id="line_9"]
script = ExtResource("dl")
text = "Are you there?"
mood = &"thinking"

[sub_resource type="Resource" id="line_10"]
script = ExtResource("dl")
text = "Is anybody back there?"
mood = &"thinking"

[sub_resource type="Resource" id="line_11"]
script = ExtResource("dl")
text = "Hmm... hello?"
mood = &"thinking"

[sub_resource type="Resource" id="line_12"]
script = ExtResource("dl")
text = "Maybe they're in the back."
mood = &"thinking"

[sub_resource type="Resource" id="line_13"]
script = ExtResource("dl")
text = "Should I ring the bell again?"
mood = &"thinking"

[sub_resource type="Resource" id="line_14"]
script = ExtResource("dl")
text = "Did I come on the wrong day?"
mood = &"thinking"

[sub_resource type="Resource" id="line_15"]
script = ExtResource("dl")
text = "This is the computer shop, right?"
mood = &"thinking"

[sub_resource type="Resource" id="line_16"]
script = ExtResource("dl")
text = "I can hear someone in there..."
mood = &"thinking"

[sub_resource type="Resource" id="line_17"]
script = ExtResource("dl")
text = "Hello?"
mood = &"irritated01"

[sub_resource type="Resource" id="line_18"]
script = ExtResource("dl")
text = "Excuse me..."
mood = &"irritated01"

[sub_resource type="Resource" id="line_19"]
script = ExtResource("dl")
text = "Hello-o?"
mood = &"irritated01"

[sub_resource type="Resource" id="line_20"]
script = ExtResource("dl")
text = "Excuse me, sir?"
mood = &"irritated01"

[sub_resource type="Resource" id="line_21"]
script = ExtResource("dl")
text = "Um. Hello?"
mood = &"irritated01"

[sub_resource type="Resource" id="line_22"]
script = ExtResource("dl")
text = "I'm right here."
mood = &"irritated01"

[sub_resource type="Resource" id="line_23"]
script = ExtResource("dl")
text = "Could I get some help, please?"
mood = &"irritated01"

[sub_resource type="Resource" id="line_24"]
script = ExtResource("dl")
text = "Yoo-hoo?"
mood = &"irritated01"

[sub_resource type="Resource" id="line_25"]
script = ExtResource("dl")
text = "Are you busy?"
mood = &"irritated02"

[sub_resource type="Resource" id="line_26"]
script = ExtResource("dl")
text = "I'm still waiting here."
mood = &"irritated02"

[sub_resource type="Resource" id="line_27"]
script = ExtResource("dl")
text = "Can someone help me?"
mood = &"irritated02"

[sub_resource type="Resource" id="line_28"]
script = ExtResource("dl")
text = "I've been standing here a while."
mood = &"irritated02"

[sub_resource type="Resource" id="line_29"]
script = ExtResource("dl")
text = "Is this a bad time?"
mood = &"irritated02"

[sub_resource type="Resource" id="line_30"]
script = ExtResource("dl")
text = "My parking runs out soon."
mood = &"irritated02"

[sub_resource type="Resource" id="line_31"]
script = ExtResource("dl")
text = "Hello? HELLO?"
mood = &"irritated02"

[sub_resource type="Resource" id="line_32"]
script = ExtResource("dl")
text = "I can wait. I guess."
mood = &"irritated02"

[sub_resource type="Resource" id="line_33"]
script = ExtResource("dl")
text = "I can go somewhere else."
mood = &"irritated03"

[sub_resource type="Resource" id="line_34"]
script = ExtResource("dl")
text = "I don't have all day."
mood = &"irritated03"

[sub_resource type="Resource" id="line_35"]
script = ExtResource("dl")
text = "Unbelievable."
mood = &"irritated03"

[sub_resource type="Resource" id="line_36"]
script = ExtResource("dl")
text = "Some service this is."
mood = &"irritated03"

[sub_resource type="Resource" id="line_37"]
script = ExtResource("dl")
text = "I'll take it to the place across town."
mood = &"irritated03"

[sub_resource type="Resource" id="line_38"]
script = ExtResource("dl")
text = "Is this how you treat customers?"
mood = &"irritated03"

[sub_resource type="Resource" id="line_39"]
script = ExtResource("dl")
text = "Do you even work here?"
mood = &"irritated03"

[sub_resource type="Resource" id="line_40"]
script = ExtResource("dl")
text = "Fine. FINE. I'll just stand here."
mood = &"irritated03"

[resource]
script = ExtResource("cv")
