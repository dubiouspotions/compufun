[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/connect_to.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/dial_up_connection_32.png" id="connection"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/dial_up_idle_32.png" id="frame_0"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/dial_up_connecting_1_32.png" id="frame_1"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/dial_up_connecting_2_32.png" id="frame_2"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/dial_up_connecting_3_32.png" id="frame_3"]

[node name="ConnectTo" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")
dialing_frames = Array[Texture2D]([ExtResource("frame_0"), ExtResource("frame_1"), ExtResource("frame_2"), ExtResource("frame_3")])

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Connect To"
show_help = true

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Form" type="VBoxContainer" parent="VBox/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="VBox/Body/Form"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="VBox/Body/Form/Header"]
layout_mode = 2
texture = ExtResource("connection")

[node name="Name" type="Label" parent="VBox/Body/Form/Header"]
unique_name_in_owner = true
layout_mode = 2

[node name="Fields" type="GridContainer" parent="VBox/Body/Form"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6
columns = 2

[node name="UserLabel" type="Label" parent="VBox/Body/Form/Fields"]
layout_mode = 2
text = "User name:"

[node name="User" type="LineEdit" parent="VBox/Body/Form/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 0)
layout_mode = 2

[node name="PasswordLabel" type="Label" parent="VBox/Body/Form/Fields"]
layout_mode = 2
text = "Password:"

[node name="Password" type="LineEdit" parent="VBox/Body/Form/Fields"]
unique_name_in_owner = true
layout_mode = 2
text = "********"
secret = true

[node name="Blank" type="Control" parent="VBox/Body/Form/Fields"]
layout_mode = 2

[node name="SavePassword" type="CheckBox" parent="VBox/Body/Form/Fields"]
layout_mode = 2
button_pressed = true
text = "Save password"

[node name="NumberLabel" type="Label" parent="VBox/Body/Form/Fields"]
layout_mode = 2
text = "Phone number:"

[node name="Number" type="LineEdit" parent="VBox/Body/Form/Fields"]
unique_name_in_owner = true
layout_mode = 2

[node name="FromLabel" type="Label" parent="VBox/Body/Form/Fields"]
layout_mode = 2
text = "Dialing from:"

[node name="From" type="HBoxContainer" parent="VBox/Body/Form/Fields"]
layout_mode = 2

[node name="Location" type="OptionButton" parent="VBox/Body/Form/Fields/From"]
layout_mode = 2
size_flags_horizontal = 3
selected = 0
item_count = 1
popup/item_0/text = "Default Location"
popup/item_0/id = 0

[node name="DialProperties" type="Button" parent="VBox/Body/Form/Fields/From"]
layout_mode = 2
disabled = true
text = "Dial Properties..."

[node name="Buttons" type="HBoxContainer" parent="VBox/Body/Form"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 2

[node name="Connect" type="Button" parent="VBox/Body/Form/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
theme_type_variation = &"DefaultButton"
text = "Connect"

[node name="Cancel" type="Button" parent="VBox/Body/Form/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
text = "Cancel"

[node name="Dialing" type="HBoxContainer" parent="VBox/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 14

[node name="Picture" type="TextureRect" parent="VBox/Body/Dialing"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
texture = ExtResource("frame_0")

[node name="Status" type="VBoxContainer" parent="VBox/Body/Dialing"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="State" type="Label" parent="VBox/Body/Dialing/Status"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
text = "Status: Dialing..."

[node name="Hang" type="HBoxContainer" parent="VBox/Body/Dialing/Status"]
layout_mode = 2
alignment = 2

[node name="CancelDialing" type="Button" parent="VBox/Body/Dialing/Status/Hang"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
theme_type_variation = &"DefaultButton"
text = "Cancel"
