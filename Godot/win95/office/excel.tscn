[gd_scene format=3]

[ext_resource type="PackedScene" path="res://win95/office/office_window.tscn" id="base"]
[ext_resource type="Script" path="res://win95/office/excel.gd" id="script"]
[ext_resource type="Script" path="res://win95/office/worksheet.gd" id="worksheet"]
[ext_resource type="Texture2D" path="res://win95/office/icons/excel_16.png" id="icon"]

[node name="Excel" instance=ExtResource("base")]
script = ExtResource("script")
untitled_name = "Book1"

[node name="TitleBar" parent="VBox" index="0"]
title = "Microsoft Excel"
