[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Theme" path="res://win95/office/office_theme.tres" id="office_theme"]
[ext_resource type="Script" path="res://win95/office/office_window.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]

[node name="OfficeWindow" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")
resizable = true
custom_minimum_size = Vector2(480, 320)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
show_minimize = true
show_maximize = true

[node name="MenuBar" type="MenuBar" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
prefer_global_menu = false

[node name="File" type="PopupMenu" parent="VBox/MenuBar"]
unique_name_in_owner = true

[node name="Toolbars" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme = ExtResource("office_theme")
theme_override_constants/separation = 0

[node name="StandardBar" type="PanelContainer" parent="VBox/Toolbars"]
layout_mode = 2
theme_type_variation = &"OfficeToolbar"

[node name="Standard" type="HBoxContainer" parent="VBox/Toolbars/StandardBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="FormattingBar" type="PanelContainer" parent="VBox/Toolbars"]
layout_mode = 2
theme_type_variation = &"OfficeToolbar"

[node name="Formatting" type="HBoxContainer" parent="VBox/Toolbars/FormattingBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="Body" type="VBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 0

[node name="StatusBar" type="HBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme = ExtResource("office_theme")
theme_override_constants/separation = 2

[node name="AssistantLayer" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
