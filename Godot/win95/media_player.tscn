[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/media_player.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/multimedia_16.png" id="icon"]
[ext_resource type="Script" path="res://win95/theme/win95bevel.gd" id="bevel"]
[ext_resource type="Resource" path="res://win95/theme/palette.tres" id="palette"]

[sub_resource type="StyleBox" id="groove"]
content_margin_top = 2.0
content_margin_bottom = 2.0
script = ExtResource("bevel")
kind = 4
palette = ExtResource("palette")

[sub_resource type="StyleBoxEmpty" id="no_fill"]

[node name="MediaPlayer" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
theme = ExtResource("theme")
script = ExtResource("script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Media Player"
icon = ExtResource("icon")
show_minimize = true

[node name="MenuBar" type="MenuBar" parent="VBox"]
layout_mode = 2
prefer_global_menu = false

[node name="File" type="PopupMenu" parent="VBox/MenuBar"]
unique_name_in_owner = true
item_count = 1
item_0/text = "Close"
item_0/id = 0

[node name="Device" type="PopupMenu" parent="VBox/MenuBar"]
item_count = 1
item_0/text = "MIDI Sequencer"
item_0/checkable = 2
item_0/checked = true
item_0/id = 0

[node name="Scale" type="PopupMenu" parent="VBox/MenuBar"]
item_count = 1
item_0/text = "Time"
item_0/checkable = 2
item_0/checked = true
item_0/id = 0

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="Rows" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Position" type="HSlider" parent="VBox/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
focus_mode = 0
step = 0.01
tick_count = 11
ticks_on_borders = true
theme_override_styles/slider = SubResource("groove")
theme_override_styles/grabber_area = SubResource("no_fill")
theme_override_styles/grabber_area_highlight = SubResource("no_fill")

[node name="Scale" type="HBoxContainer" parent="VBox/Body/Rows"]
layout_mode = 2

[node name="Zero" type="Label" parent="VBox/Body/Rows/Scale"]
layout_mode = 2
size_flags_horizontal = 3
text = "0:00.0"

[node name="Length" type="Label" parent="VBox/Body/Rows/Scale"]
unique_name_in_owner = true
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="VBox/Body/Rows"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Play" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Play"
focus_mode = 0
icon_alignment = 1

[node name="Stop" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Stop"
focus_mode = 0
icon_alignment = 1

[node name="Eject" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Eject"
focus_mode = 0
disabled = true
icon_alignment = 1

[node name="Gap" type="Control" parent="VBox/Body/Rows/Buttons"]
custom_minimum_size = Vector2(8, 0)
layout_mode = 2

[node name="Start" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Previous Mark"
focus_mode = 0
icon_alignment = 1

[node name="Back" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Rewind"
focus_mode = 0
icon_alignment = 1

[node name="Forward" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Fast Forward"
focus_mode = 0
icon_alignment = 1

[node name="End" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 22)
layout_mode = 2
tooltip_text = "Next Mark"
focus_mode = 0
icon_alignment = 1

[node name="StatusWell" type="PanelContainer" parent="VBox"]
layout_mode = 2
theme_type_variation = &"StatusWell"

[node name="Status" type="Label" parent="VBox/StatusWell"]
unique_name_in_owner = true
layout_mode = 2

[node name="Player" type="AudioStreamPlayer" parent="."]
unique_name_in_owner = true
bus = &"Win95"
