[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/wordpad.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/document_pencil_16.png" id="icon"]

[node name="Wordpad" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")
opens = Array[String](["doc", "wri"])
custom_minimum_size = Vector2(480, 300)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "WordPad"
icon = ExtResource("icon")
show_minimize = true
show_maximize = true

[node name="MenuBar" type="MenuBar" parent="VBox"]
layout_mode = 2
prefer_global_menu = false

[node name="File" type="PopupMenu" parent="VBox/MenuBar"]
unique_name_in_owner = true
item_count = 3
item_0/text = "New"
item_0/id = 0
item_1/text = "Save"
item_1/id = 2
item_2/text = "Close"
item_2/id = 1

[node name="Page" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 4

[node name="Text" type="TextEdit" parent="VBox/Page"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
wrap_mode = 1

[node name="Assistant" type="PanelContainer" parent="VBox/Page"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_type_variation = &"TipPanel"

[node name="Helper" type="VBoxContainer" parent="VBox/Page/Assistant"]
unique_name_in_owner = true
layout_mode = 2
alignment = 1

[node name="Picture" type="TextureRect" parent="VBox/Page/Assistant/Helper"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_horizontal = 4
expand_mode = 1
stretch_mode = 5

[node name="Speech" type="Label" parent="VBox/Page/Assistant/Helper"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
text = "It looks like you are writing. Need a hand?"
horizontal_alignment = 1
autowrap_mode = 3
