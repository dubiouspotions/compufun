[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/properties_window.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]

[node name="PropertiesWindow" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
offset_right = 300.0
offset_bottom = 200.0
theme = ExtResource("theme")
script = ExtResource("script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Properties"

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Column" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="VBox/Body/Column"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Icon" type="TextureRect" parent="VBox/Body/Column/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
stretch_mode = 2

[node name="Name" type="Label" parent="VBox/Body/Column/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
vertical_alignment = 1
clip_text = true

[node name="Rule1" type="HSeparator" parent="VBox/Body/Column"]
layout_mode = 2

[node name="Facts" type="GridContainer" parent="VBox/Body/Column"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
columns = 2

[node name="TypeLabel" type="Label" parent="VBox/Body/Column/Facts"]
layout_mode = 2
text = "Type:"

[node name="Type" type="Label" parent="VBox/Body/Column/Facts"]
unique_name_in_owner = true
layout_mode = 2

[node name="LocationLabel" type="Label" parent="VBox/Body/Column/Facts"]
layout_mode = 2
text = "Location:"

[node name="Location" type="Label" parent="VBox/Body/Column/Facts"]
unique_name_in_owner = true
layout_mode = 2

[node name="ContainsLabel" type="Label" parent="VBox/Body/Column/Facts"]
unique_name_in_owner = true
layout_mode = 2
text = "Contains:"

[node name="Contains" type="Label" parent="VBox/Body/Column/Facts"]
unique_name_in_owner = true
layout_mode = 2

[node name="Rule2" type="HSeparator" parent="VBox/Body/Column"]
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="VBox/Body/Column"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 6

[node name="Ok" type="Button" parent="VBox/Body/Column/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
theme_type_variation = &"DefaultButton"
text = "OK"

[node name="Cancel" type="Button" parent="VBox/Body/Column/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
text = "Cancel"
