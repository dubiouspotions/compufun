[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/folder_window.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Script" path="res://win95/icon_view.gd" id="icon_view"]
[ext_resource type="PackedScene" path="res://win95/file_icon.tscn" id="file_icon"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/my_computer_16.png" id="my_computer_16"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/drive_floppy_35_32.png" id="floppy"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/drive_hard_32.png" id="hard"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/drive_cdrom_32.png" id="cdrom"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/folder_control_panel_32.png" id="control_panel"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/folder_printers_32.png" id="printers"]

[node name="FolderWindow" type="PanelContainer"]
offset_right = 320.0
offset_bottom = 240.0
theme = ExtResource("theme")
script = ExtResource("script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "My Computer"
icon = ExtResource("my_computer_16")
show_minimize = true
show_maximize = true

[node name="MenuBar" type="MenuBar" parent="VBox"]
layout_mode = 2
prefer_global_menu = false

[node name="File" type="PopupMenu" parent="VBox/MenuBar"]
unique_name_in_owner = true
item_count = 1
item_0/text = "Close"
item_0/id = 0

[node name="Edit" type="PopupMenu" parent="VBox/MenuBar"]
item_count = 1
item_0/text = "Select All"
item_0/id = 0

[node name="View" type="PopupMenu" parent="VBox/MenuBar"]
item_count = 4
item_0/text = "Large Icons"
item_0/checkable = 2
item_0/checked = true
item_0/id = 0
item_1/text = "Small Icons"
item_1/checkable = 2
item_1/id = 1
item_2/text = "List"
item_2/checkable = 2
item_2/id = 2
item_3/text = "Details"
item_3/checkable = 2
item_3/id = 3

[node name="Help" type="PopupMenu" parent="VBox/MenuBar"]
item_count = 1
item_0/text = "About Windows 95"
item_0/id = 0

[node name="Field" type="PanelContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"FieldPanel"

[node name="Scroll" type="ScrollContainer" parent="VBox/Field"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Items" type="HFlowContainer" parent="VBox/Field/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/h_separation = 0
theme_override_constants/v_separation = 0
script = ExtResource("icon_view")

[node name="Floppy" parent="VBox/Field/Scroll/Items" instance=ExtResource("file_icon")]
layout_mode = 2
text = "3½ Floppy (A:)"
icon = ExtResource("floppy")

[node name="HardDisk" parent="VBox/Field/Scroll/Items" instance=ExtResource("file_icon")]
layout_mode = 2
text = "(C:)"
icon = ExtResource("hard")

[node name="CdRom" parent="VBox/Field/Scroll/Items" instance=ExtResource("file_icon")]
layout_mode = 2
text = "(D:)"
icon = ExtResource("cdrom")

[node name="ControlPanel" parent="VBox/Field/Scroll/Items" instance=ExtResource("file_icon")]
layout_mode = 2
text = "Control Panel"
icon = ExtResource("control_panel")

[node name="Printers" parent="VBox/Field/Scroll/Items" instance=ExtResource("file_icon")]
layout_mode = 2
text = "Printers"
icon = ExtResource("printers")

[node name="StatusGap" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 2)
layout_mode = 2

[node name="StatusBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Objects" type="PanelContainer" parent="VBox/StatusBar"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_type_variation = &"StatusWell"

[node name="ObjectCount" type="Label" parent="VBox/StatusBar/Objects"]
unique_name_in_owner = true
layout_mode = 2
text = "0 object(s)"

[node name="Rest" type="PanelContainer" parent="VBox/StatusBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"StatusWell"
