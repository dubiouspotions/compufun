[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/message_box.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/message_error_32.png" id="error"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/message_warning_32.png" id="warning"]

[node name="MessageBox" type="PanelContainer"]
offset_right = 360.0
offset_bottom = 120.0
theme = ExtResource("theme")
script = ExtResource("script")
error_icon = ExtResource("error")
warning_icon = ExtResource("warning")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Column" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Message" type="HBoxContainer" parent="VBox/Body/Column"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Icon" type="TextureRect" parent="VBox/Body/Column/Message"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
texture = ExtResource("error")
stretch_mode = 2

[node name="Text" type="Label" parent="VBox/Body/Column/Message"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="VBox/Body/Column"]
unique_name_in_owner = true
layout_mode = 2
alignment = 1
theme_override_constants/separation = 6
