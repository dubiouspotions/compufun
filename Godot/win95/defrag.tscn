[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/defrag.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons_extracted/disk_drive_box_16.png" id="icon"]

[node name="Defrag" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Disk Defragmenter"
icon = ExtResource("icon")
show_minimize = true

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="Rows" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Status" type="Label" parent="VBox/Body/Rows"]
unique_name_in_owner = true
layout_mode = 2
text = "Drive C is 34% fragmented."

[node name="MapField" type="PanelContainer" parent="VBox/Body/Rows"]
layout_mode = 2
theme_type_variation = &"FieldPanel"

[node name="Map" type="Control" parent="VBox/Body/Rows/MapField"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 120)
layout_mode = 2

[node name="Progress" type="ProgressBar" parent="VBox/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="VBox/Body/Rows"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 6

[node name="Start" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
text = "Start"

[node name="CloseButton" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
text = "Close"
