[gd_scene format=3]

[ext_resource type="Script" path="res://win95/title_bar.gd" id="script"]

[node name="TitleBar" type="PanelContainer"]
theme_type_variation = &"TitleBar"
script = ExtResource("script")

[node name="Row" type="HBoxContainer" parent="."]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
theme_override_constants/separation = 0

[node name="Icon" type="TextureRect" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(19, 16)
layout_mode = 2
stretch_mode = 2

[node name="Title" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
vertical_alignment = 1
clip_text = true

[node name="Minimize" type="Button" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(16, 14)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"CaptionMinimizeButton"
icon_alignment = 1

[node name="Maximize" type="Button" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(16, 14)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"CaptionMaximizeButton"
icon_alignment = 1

[node name="Help" type="Button" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(16, 14)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"CaptionHelpButton"
icon_alignment = 1

[node name="CloseGap" type="Control" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(2, 0)
layout_mode = 2

[node name="Close" type="Button" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(16, 14)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"CaptionCloseButton"
icon_alignment = 1
