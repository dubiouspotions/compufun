[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/calculator.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]

[node name="Calculator" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Calculator"
show_minimize = true

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="Rows" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DisplayField" type="PanelContainer" parent="VBox/Body/Rows"]
layout_mode = 2
theme_type_variation = &"FieldPanel"

[node name="Display" type="Label" parent="VBox/Body/Rows/DisplayField"]
unique_name_in_owner = true
layout_mode = 2
text = "0"
horizontal_alignment = 2
clip_text = true

[node name="Keys" type="GridContainer" parent="VBox/Body/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 5
columns = 4

[node name="Seven" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "7"

[node name="Eight" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "8"

[node name="Nine" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "9"

[node name="Divide" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "/"

[node name="Four" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "4"

[node name="Five" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "5"

[node name="Six" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
