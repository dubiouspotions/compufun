text = "6"

[node name="Multiply" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "*"

[node name="One" type="Button" parent="VBox/Body/Rows/Keys"]
custom_minimum_size = Vector2(36, 28)
layout_mode = 2
focus_mode = 0
text = "1"

[node name="Two" type="Button" parent="VBox/Body/Rows/Keys"]
