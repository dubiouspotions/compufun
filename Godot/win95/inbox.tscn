[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/inbox.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/documents_multiple_16.png" id="icon"]
[ext_resource type="Script" path="res://win95/email.gd" id="email"]

[sub_resource type="Resource" id="email_0"]
script = ExtResource("email")
from = "Mom"
subject = "Did the computer work?"
body = "Hi sweetie, did they fix the computer yet? Your father wants to play his card game. Love, Mom"

[sub_resource type="Resource" id="email_1"]
script = ExtResource("email")
from = "CompuFun"
subject = "Thank you for your visit"
body = "Thank you for choosing CompuFun for your computer repair. We look forward to seeing you again!"

[sub_resource type="Resource" id="email_2"]
script = ExtResource("email")
from = "Unknown"
subject = "it is listening"
body = "do not let them open the case\ndo not let them open the case\ndo not let them"

[node name="Inbox" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")
emails = Array[ExtResource("email")]([SubResource("email_0"), SubResource("email_1"), SubResource("email_2")])

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Inbox"
icon = ExtResource("icon")
show_minimize = true
show_maximize = true

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4

[node name="Rows" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="List" type="ItemList" parent="VBox/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 90)
layout_mode = 2

[node name="ReaderField" type="PanelContainer" parent="VBox/Body/Rows"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"FieldPanel"

[node name="Reader" type="Label" parent="VBox/Body/Rows/ReaderField"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
autowrap_mode = 3
vertical_alignment = 0
