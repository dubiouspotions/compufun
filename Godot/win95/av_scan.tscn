[gd_scene format=3]

[ext_resource type="Theme" path="res://win95/win95.tres" id="theme"]
[ext_resource type="Script" path="res://win95/av_scan.gd" id="script"]
[ext_resource type="PackedScene" path="res://win95/title_bar.tscn" id="title_bar"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/find_files_16.png" id="icon"]
[ext_resource type="Texture2D" path="res://win95/theme/icons/find_files_32.png" id="picture"]

[node name="AvScan" type="PanelContainer"]
theme = ExtResource("theme")
script = ExtResource("script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TitleBar" parent="VBox" instance=ExtResource("title_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "CompuFun AntiVirus"
icon = ExtResource("icon")
show_minimize = true

[node name="Body" type="MarginContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Rows" type="VBoxContainer" parent="VBox/Body"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="HBoxContainer" parent="VBox/Body/Rows"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Picture" type="TextureRect" parent="VBox/Body/Rows/Heading"]
layout_mode = 2
size_flags_vertical = 0
texture = ExtResource("picture")
stretch_mode = 2

[node name="Status" type="Label" parent="VBox/Body/Rows/Heading"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 32)
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Path" type="Label" parent="VBox/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(344, 0)
layout_mode = 2
clip_text = true
text_overrun_behavior = 3

[node name="Progress" type="ProgressBar" parent="VBox/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="Results" type="ItemList" parent="VBox/Body/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(344, 90)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="VBox/Body/Rows"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 6

[node name="ScanNow" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
theme_type_variation = &"DefaultButton"
text = "Scan Now"

[node name="Clean" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
text = "Clean"

[node name="CloseButton" type="Button" parent="VBox/Body/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(75, 23)
layout_mode = 2
text = "Close"
