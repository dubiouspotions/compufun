[sub_resource type="Resource" id="f1"]
script = ExtResource("file")
name = "Disk Defragmenter"
icon = ExtResource("icon_disk_drive_box")
target = "C:\\WINDOWS\\DEFRAG.EXE"

[sub_resource type="Resource" id="f2"]
script = ExtResource("file")
name = "System Tools"
icon = ExtResource("group")
is_folder = true
children = Array[Resource]([SubResource("f1")])

